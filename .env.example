# ============================================================
# LabelHub .env.example — 复制为 .env 并填入真实值
# ★ 警告:.env 文件不进 Git(已在 .gitignore 中)
# ============================================================

# --- OpenAI-compatible LLM ---
# mock keeps deterministic local behavior. Use openai_compatible/doubao only when all LLM_* values are set.
LLM_PROVIDER=mock
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your-api-key-here
LLM_MODEL=doubao-seed-2.0-lite
LLM_ALLOWED_MODELS=doubao-seed-2.0-lite
LLM_TIMEOUT_MS=30000
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_MS=200
LLM_RETRY_MAX_BACKOFF_MS=2000
LLM_DRY_RUN_QUOTA_MAX_RUNS=0
LLM_DRY_RUN_CIRCUIT_MAX_FAILURES=0
LLM_DRY_RUN_GUARD_WINDOW_MINUTES=60

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=labelhub
DB_PASSWORD=labelhub_dev
DB_NAME=labelhub

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=336h

# --- Upload ---
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_SIZE_MB=10

# --- Export ---
EXPORT_DIR=./data/exports

# --- API ---
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173
