# ============================================================
# LabelHub .env.example — 复制为 .env 并填入真实值
# ★ 警告:.env 文件不进 Git(已在 .gitignore 中)
# ============================================================

# --- 豆包 LLM(参赛方提供) ---
DOUBAO_API_KEY=your-api-key-here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_EP_ID=your-ep-id-here
DOUBAO_MODEL=doubao-seed-2.0-lite

# LLM provider: doubao | mock
LLM_PROVIDER=doubao

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=labelhub
DB_PASSWORD=labelhub_dev
DB_NAME=labelhub

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=336h

# --- Upload ---
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_SIZE_MB=10

# --- Export ---
EXPORT_DIR=./data/exports

# --- API ---
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173
