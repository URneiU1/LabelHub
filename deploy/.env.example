# Copy to deploy/.env before running docker-compose.prod.yml.
# Do not commit deploy/.env.

# For prod set a real domain so Caddy provisions TLS, e.g. labelhub.example.com.
# Keeping :80 means plain HTTP (no HSTS) — only for a local compose smoke test.
CADDY_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# asynqmon admin UI is fronted by Caddy basic auth. Generate the bcrypt hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
ASYNQMON_USER=admin
ASYNQMON_PASSWORD_HASH=change-me-bcrypt-hash-from-caddy-hash-password

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=labelhub
MYSQL_USER=labelhub
MYSQL_PASSWORD=change-me-db-password

JWT_SECRET=change-me-to-a-random-64-char-string-minimum
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=336h

API_CORS_ORIGINS=https://labelhub.example.com
UPLOAD_DIR=/var/lib/labelhub/uploads
UPLOAD_MAX_SIZE_MB=10

EXPORT_DOWNLOAD_SECRET=change-me-to-a-random-32-char-string-minimum
EXPORT_DOWNLOAD_TTL=600

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_ALLOWED_MODELS=mock-model
LLM_TIMEOUT_MS=30000
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_MS=200
LLM_RETRY_MAX_BACKOFF_MS=2000
LLM_DRY_RUN_QUOTA_MAX_RUNS=0
LLM_DRY_RUN_CIRCUIT_MAX_FAILURES=0
LLM_DRY_RUN_GUARD_WINDOW_MINUTES=60

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH=20
AI_REVIEW_SWEEPER_ENABLED=true
AI_REVIEW_SWEEPER_INTERVAL_MS=60000
AI_REVIEW_STALL_TIMEOUT_MS=300000
AI_REVIEW_SWEEPER_BATCH=20
ORPHAN_TEMP_FILE_CLEANER_ENABLED=true
